# Copy this file to .env and fill in real values. Never commit .env.
# Every value below is intentionally blank or non-secret.

# META / WHATSAPP CLOUD API
# Permanent System User token with whatsapp_business_messaging and
# whatsapp_business_management. Rotate any value previously committed to Git.
META_ACCESS_TOKEN=

# Numeric test-phone ID from Meta's WhatsApp API Setup screen (not the phone number).
META_PHONE_NUMBER_ID=

# App Settings > Basic. Used only for token debugging and webhook-signature work.
META_APP_ID=
META_APP_SECRET=

# A random secret you invent and enter in Meta's webhook configuration.
WEBHOOK_VERIFY_TOKEN=

# Pin the Graph API version you have verified in Meta's current documentation.
META_API_VERSION=v25.0

# N8N / LOCAL TUNNEL
# Public HTTPS base URL of the local n8n instance, without a trailing slash.
N8N_URL=

# Optional: used only when manually exporting or publishing workflow JSON via API.
N8N_API_KEY=

# Optional: lets scripts post directly through the public ngrok URL.
N8N_WEBHOOK_BASE=

# SUPABASE
# Project Settings > API. The service-role key is server-side only.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# DEEPSEEK
# Create a new key. Never reuse the key pasted into chat or commit it anywhere.
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_MAX_TOKENS=512

# The only WhatsApp number allowed to invoke DeepSeek in v1, digits only and no +.
ALLOWED_WHATSAPP_NUMBER=
