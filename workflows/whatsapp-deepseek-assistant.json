    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json).reverse();\n\nconst history = rows\n  .filter(r => r.message_text)\n  .map(r => ({\n    role: r.direction === 'out' ? 'assistant' : 'user',\n    content: r.message_text,\n  }));\n\nreturn [{\n  json: {\n    model: 'deepseek-v4-flash',\n    thinking: { type: 'disabled' },\n    max_tokens: 512,\n    messages: [\n      { role: 'system', content: 'You are a helpful assistant replying over WhatsApp. Keep answers short and plain.' },\n      ...history,\n    ],\n  },\n}];"
      },
      "type": "n8n-nodes-base.code",
